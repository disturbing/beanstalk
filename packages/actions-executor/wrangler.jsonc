{
  "$schema": "node_modules/wrangler/config-schema.json",
  // The Actions job executor (docs/claude-opus/26-actions-job-executor.md): one Cloudflare
  // Container per GitHub Actions job (D6). The control plane (the gateway's ActionsRunDO) calls
  // `startJob` / `cancelJob` over a service binding; each job gets its own ActionsJobContainer
  // (a Container Durable Object named by the job id), which runs act in packages/actions-runner,
  // relays its log batches and result to the gateway's `ActionsJobs` sink, and destroys the
  // container when the job ends. A separate Worker from the gateway: untrusted job I/O and the
  // 400 MB image never ride the engine's deploys, and the job container's outbound handlers
  // see only this Worker's bindings.
  "name": "gitstalk-actions-executor",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-08",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "LOG_LEVEL": "info",
    // "service": secrets, log batches and results go to the gateway's ActionsJobs entrypoint
    // (ACTIONS_JOBS). "standalone": a test stack without the control plane; batches go to the
    // ACTIONS_LOGS bucket and secrets come from STANDALONE_SECRETS.
    "SINK_MODE": "service",
    // Must equal containers[].max_instances; the gateway's RunnerCapacity caps Actions leases
    // at its own ACTIONS_MAX_INSTANCES, which must not exceed it.
    "ACTIONS_MAX_INSTANCES": "16",
    // The dependency cache (docs/claude-opus/27-ci-dependency-cache.md): node_modules restored
    // into a tmpfs from chunked R2 snapshots. "off" stops adding the cache steps to jobs.
    "DEPS_CACHE_MODE": "on",
    // Compressed snapshot cap (4 GiB). A repository or org variable
    // GITSTALK_DEPS_SNAPSHOT_MAX (e.g. "2GiB"; BEANSTALK_* before the rename) changes it, up to DEPS_REPO_MAX_BYTES.
    "DEPS_SNAPSHOT_MAX_BYTES": "4294967296",
    // The node_modules tmpfs: half of standard-4's 12 GiB. Tied to the instance type: a larger
    // instance raises it here (or in an environment override), no code change.
    "DEPS_TMPFS_MAX_BYTES": "6442450944",
    // Per repository: all snapshots together (10 GB), least recently restored evicted first.
    "DEPS_REPO_MAX_BYTES": "10000000000",
    // A snapshot nobody restored for this many days is deleted by the daily sweep.
    "DEPS_IDLE_DAYS": "7",
  },
  // ADMIN_TOKEN guards the admin routes (a test stack starts jobs with them).
  "secrets": { "required": ["ADMIN_TOKEN"] },
  // Workers Cache only on DepsChunkCache: the immutable dependency chunks in front of R2
  // (tiered; a hit runs no code). Cached responses survive executor deploys.
  "cache": { "enabled": false, "cross_version_cache": true },
  "exports": {
    "default": { "type": "worker", "cache": { "enabled": false } },
    "DepsChunkCache": { "type": "worker", "cache": { "enabled": true } },
    "ActionsJobContainer": { "type": "durable-object", "storage": "sqlite" },
    // One per repository: the dependency snapshots' index, limits and daily sweep.
    "DepsCacheIndex": { "type": "durable-object", "storage": "sqlite" },
  },
  "durable_objects": {
    "bindings": [
      { "name": "ACTIONS_JOBS_DO", "class_name": "ActionsJobContainer" },
      { "name": "DEPS_INDEX", "class_name": "DepsCacheIndex" },
    ],
  },
  "containers": [
    {
      "class_name": "ActionsJobContainer",
      "image": "../actions-runner/Dockerfile",
      "image_build_context": "../..",
      // GitHub's ubuntu-latest is 4 vCPU / 16 GB; standard-4 (4 vCPU, 12 GiB, 20 GB) ran the
      // fastify suite at GitHub's speed in the spike.
      "instance_type": "standard-4",
      "max_instances": 16,
    },
  ],
  // The gateway's executor sink entrypoint: secrets, log batches and results, by report token.
  "services": [
    { "binding": "ACTIONS_JOBS", "service": "gitstalk-gateway", "entrypoint": "ActionsJobs" },
  ],
  // Standalone mode only: where log batches go without the control plane.
  "r2_buckets": [
    { "binding": "ACTIONS_LOGS", "bucket_name": "gitstalk-actions-logs" },
    // Dependency snapshots: deps/<repository id>/{chunks,manifests}/..., per repository only.
    { "binding": "DEPS_CACHE", "bucket_name": "gitstalk-deps-cache" },
  ],
}
