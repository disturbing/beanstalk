{
  // Test-only Worker for @beanstalk/shared-identity: the bindings the library expects, so
  // `wrangler types` and Miniflare give the tests a real D1 and a real rate limiter.
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "shared-identity-test",
  "main": "./test-worker.ts",
  "compatibility_date": "2026-10-07",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "beanstalk-identity",
      "migrations_dir": "../migrations",
    },
  ],
  "ratelimits": [
    {
      "name": "SIGNIN_RATE_LIMIT",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
}
