{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beanstalk-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-03",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "LOG_LEVEL": "info",
    // Must match the namespace of the ARTIFACTS binding below; the git proxy serves /git/<namespace>/.
    "ARTIFACTS_NAMESPACE": "beanstalk-race",
    "RUN_TOKEN_TTL_SECONDS": "3600",
    // §3: per-job Artifacts tokens live at most 10 minutes.
    "ARTIFACTS_TOKEN_TTL_SECONDS": "600",
    // The web app, named in the hint a request without a usable credential gets.
    "WEB_URL": "https://beanstalk-web.devaccounts-1password.workers.dev",
    // The runner pool races and repositories share (RunnerCapacity): containers[].max_instances.
    "RUNNER_MAX_INSTANCES": "48",
  },
  // ADMIN_TOKEN guards the admin API; RUN_TOKEN_SECRET signs slot, seed and view tokens.
  // Locally they come from .dev.vars (see .dev.vars.example); remotely from `wrangler secret put`.
  "secrets": { "required": ["ADMIN_TOKEN", "RUN_TOKEN_SECRET"] },
  // Durable Object classes exported from src/index.ts. `exports` replaces `migrations`.
  "exports": {
    "RunDO": { "type": "durable-object", "storage": "sqlite" },
    // One instance ("runs") listing every run for the web app.
    "RunIndex": { "type": "durable-object", "storage": "sqlite" },
    "Runner": { "type": "durable-object", "storage": "sqlite" },
    // stream_diffs: one per run, beside its RunDO (docs/claude-17-streaming-diffs.md).
    "RunStreamDO": { "type": "durable-object", "storage": "sqlite" },
    // One instance ("pool"): race reservations and repositories' pre-land sandbox leases.
    "RunnerCapacity": { "type": "durable-object", "storage": "sqlite" },
  },
  "durable_objects": {
    "bindings": [
      { "name": "RUNS", "class_name": "RunDO" },
      { "name": "RUN_INDEX", "class_name": "RunIndex" },
      { "name": "RUNNER", "class_name": "Runner" },
      { "name": "RUN_STREAMS", "class_name": "RunStreamDO" },
      { "name": "RUNNER_CAPACITY", "class_name": "RunnerCapacity" },
    ],
  },
  // Per run: one committer (squash, revert, update-ref), one instance per emulated CI slot,
  // and one sandbox per agent slot for v2's pre-land checks: agents + ci_slots + 1 (§5, §6).
  // A repository engine: committer + CI slots, plus one sandbox per bean in check, leased from
  // RunnerCapacity (RUNNER_MAX_INSTANCES above must equal max_instances).
  // standard-2 (1 vCPU): on standard-1 (1/2 vCPU) suites took 12.7 s median, 0.9 s locally.
  // 24 instances fit a 12-agent v2 run (15) beside a 12-agent queue run (3).
  "containers": [
    {
      "class_name": "Runner",
      "image": "../runner/Dockerfile",
      "image_build_context": "../..",
      "instance_type": "standard-4",
      "max_instances": 48,
    },
  ],
  // Two namespaces, kept apart: ARTIFACTS holds race repos (`race-<run>`), which the hourly
  // sweep deletes once their race is over; REPOS holds people's repositories (`repo-<id>`),
  // which the sweep never lists (docs/claude-opus/20-repositories.md §2).
  "artifacts": [
    { "binding": "ARTIFACTS", "namespace": "beanstalk-race", "remote": true },
    { "binding": "REPOS", "namespace": "beanstalk-repos", "remote": true },
  ],
  // repo-events (docs/claude-opus/20-repositories.md §6, backlog 2.6): repository engines send
  // landings, promotions, reverts, decisions and bean events; this Worker's own consumer
  // writes the D1 indexes (beans, decisions, repo_daily, repo_lines, activity). Batches do not
  // wait to fill (max_batch_timeout 0): delivery is the index's whole delay.
  "queues": {
    "producers": [{ "binding": "REPO_EVENTS", "queue": "beanstalk-repo-events" }],
    "consumers": [
      {
        "queue": "beanstalk-repo-events",
        "max_batch_size": 100,
        "max_batch_timeout": 0,
        "max_retries": 10,
      },
    ],
  },
  // The repository registry (FORGE, docs/claude-opus/20-repositories.md): records, per-owner
  // name uniqueness and repository activity; migrations in migrations/. Accounts (IDENTITY_DB):
  // git credentials may be people's tokens (bsu_, bss_), verified against the identity database
  // (packages/shared-identity, docs/claude-opus/19-accounts-and-auth.md).
  "d1_databases": [
    {
      "binding": "FORGE",
      "database_name": "beanstalk-forge",
      "database_id": "e19b5975-8fb2-4158-9dc8-3ca013b1de2a",
      "migrations_dir": "migrations",
    },
    {
      "binding": "IDENTITY_DB",
      "database_name": "beanstalk-identity",
      "database_id": "bd0e58e5-4b1b-4a40-a143-a0eee6fa5075",
      "migrations_dir": "../shared-identity/migrations",
    },
  ],
  // Product analytics (docs/claude-opus/19 §10): a bean pushed to a person's repository. The
  // web app writes sign-up, connect and repository-created events to the same dataset.
  "analytics_engine_datasets": [{ "binding": "PRODUCT_EVENTS", "dataset": "product_events" }],
}
