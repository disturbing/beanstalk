{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beanstalk-web",
  // vinext's Workers entry; the app's routes live in app/ (App Router).
  "main": "vinext/server/fetch-handler",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "assets": { "directory": "dist/client", "not_found_handling": "none", "binding": "ASSETS" },
  // Live runs, decisions and the repository views come from the gateway over RPC (never HTTP).
  // MCP: the OAuth consent screen and connected agents (its AgentSessionsRpc).
  "services": [
    { "binding": "GATEWAY", "service": "beanstalk-gateway" },
    { "binding": "MCP", "service": "beanstalk-mcp" },
    // Actions (docs/claude-opus/25): the gateway's ActionsRpc on its named entrypoint.
    { "binding": "ACTIONS", "service": "beanstalk-gateway", "entrypoint": "Actions" },
  ],
  // Accounts (docs/claude-opus/19-accounts-and-auth.md): people, passkeys, sessions, tokens,
  // audit. The schema is packages/shared-identity/migrations; apply it from this package:
  // `wrangler d1 migrations apply beanstalk-identity --remote`.
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "beanstalk-identity",
      "database_id": "bd0e58e5-4b1b-4a40-a143-a0eee6fa5075",
      "migrations_dir": "../shared-identity/migrations",
    },
  ],
  // Sign-in endpoints: 10 attempts a minute per IP, and per email or handle.
  "ratelimits": [
    {
      "name": "SIGNIN_RATE_LIMIT",
      "namespace_id": "4101",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  // Product analytics (docs/claude-opus/19 §10): sign-up, connect, repository created. The
  // dataset is created on first write; `scripts/product-events.mjs` reads the counts.
  "analytics_engine_datasets": [{ "binding": "PRODUCT_EVENTS", "dataset": "product_events" }],
  "vars": {
    "LOG_LEVEL": "info",
    // How Ask turns a question into a view spec: "keywords" (deterministic, the default) or
    // "workers-ai", which also needs an `ai` binding named AI (see README).
    "ASK_CLASSIFIER": "keywords",
    "ASK_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // Who decides what the Plot shows (docs/claude-opus/14 §5): "jev" (TypeSafe's Jev on
    // Workers AI, through the AI Gateway named in JEV_GATEWAY; unified billing) or "rules".
    // Any Jev failure falls back to the rules, and every pick leaves a receipt.
    "PICKER": "jev",
    "JEV_GATEWAY": "default",
    // Email magic links stay off (and hidden) until a sender domain is onboarded to
    // Cloudflare Email Service. To turn them on: set this to the domain (mail comes from
    // signin@<domain>) and add `"send_email": [{ "name": "EMAIL" }]`. See doc 19.
    "EMAIL_SENDER_DOMAIN": "",
    // Turnstile on sign-in and sign-up (docs/claude-opus/19 §5): on only when BOTH this site
    // key and the TURNSTILE_SECRET_KEY secret are set; with either missing it is off (logged).
    // To turn it on: create a managed widget for this deployment's hostname, set its site key
    // here and `wrangler secret put TURNSTILE_SECRET_KEY`. TURNSTILE_HOSTNAMES (comma-separated) defaults to the request's own
    // host. TURNSTILE_TEST_KEYS=allow accepts Cloudflare's test keys (staging only, never live).
    "TURNSTILE_SITE_KEY": "",
    "TURNSTILE_HOSTNAMES": "",
    "TURNSTILE_TEST_KEYS": "",
    // Repositories (docs/claude-opus/20-repositories.md): the public addresses a new repository's
    // start page prints. Git is served by this host, as on GitHub: `<GIT_ORIGIN>/<owner>/<repo>.git`
    // (app/[owner]/[repo]/{info/refs,git-upload-pack,git-receive-pack} forward to the gateway).
    "GIT_ORIGIN": "https://beanstalk-web.devaccounts-1password.workers.dev",
    "MCP_URL": "https://beanstalk-mcp.devaccounts-1password.workers.dev/mcp",
    // Git over SSH (`ssh://git@<SSH_HOST>/<owner>/<repo>.git`): empty until the SSH endpoint is
    // live; /beanstalk:setup then finishes with HTTPS and a token (docs/claude-opus/19).
    "SSH_HOST": "",
    // The SSH host key's fingerprint (`SHA256:…`, as `ssh` prints it), shown in Settings → SSH
    // keys and on a new repository's page so people can check it (docs/claude-opus/21).
    "SSH_HOST_KEY_FINGERPRINT": "",
    // Actions (docs/claude-opus/25): where the Automations tab reads workflows and runs.
    // "gateway": the gateway's Actions control plane (the ACTIONS binding). "fixtures": the
    // web's own fake (src/actions/fake), for a staging stack without one; every page says so.
    // Empty: the tab says Actions are not running on this deployment.
    "ACTIONS_SOURCE": "gateway",
  },
  // Workers AI: Jev (typesafe/jev) for the picker, and the optional Ask classifier model.
  // Billed to the account; no API key is involved. `remote` makes local dev call it too.
  "ai": { "binding": "AI", "remote": true },
  // DEMO_PASSWORD gates decisions (cookie after the login form). Locally it comes from
  // .dev.vars (see .dev.vars.example); remotely from `wrangler secret put DEMO_PASSWORD`.
  "secrets": { "required": ["DEMO_PASSWORD"] },
}
