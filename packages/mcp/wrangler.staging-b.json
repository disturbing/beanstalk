{
  "name": "beanstalk-mcp-staging-b",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "LOG_LEVEL": "info",
    "PUBLIC_URL": "https://beanstalk-mcp-staging-b.devaccounts-1password.workers.dev",
    "WEB_URL": "https://beanstalk-web-staging-b.devaccounts-1password.workers.dev",
    "GIT_ORIGIN": "https://beanstalk-gateway-staging-b.devaccounts-1password.workers.dev",
    "DEMO_RUN": "",
    "ASK_CLASSIFIER": "keywords",
    "ASK_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    "PICKER": "jev",
    "JEV_GATEWAY": "default"
  },
  "ai": {
    "binding": "AI",
    "remote": true
  },
  "services": [
    {
      "binding": "GATEWAY",
      "service": "beanstalk-gateway-staging-b"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "b2668129eb1949ebbad139180533d71d"
    }
  ],
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "beanstalk-identity-staging-b",
      "database_id": "d2c2ae1b-1abf-423b-9315-ba03b82b477d",
      "migrations_dir": "../shared-identity/migrations"
    }
  ]
}
