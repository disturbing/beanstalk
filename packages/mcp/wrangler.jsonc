{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "beanstalk-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-04",
  // AsyncLocalStorage, which the Agents SDK's MCP handler uses. global_fetch_strictly_public:
  // the OAuth provider fetches Client ID Metadata Documents only from public addresses.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": {
    "LOG_LEVEL": "info",
    // This Worker's own origin: the OAuth issuer and the protected resource `<PUBLIC_URL>/mcp`.
    "PUBLIC_URL": "https://beanstalk-mcp.devaccounts-1password.workers.dev",
    // The web app the tools link to (`preview_url`, `preview_link`) and where /authorize sends
    // people to sign in and approve a client (`/connect`).
    "WEB_URL": "https://beanstalk-web.devaccounts-1password.workers.dev",
    // The run OAuth sessions read until persistent repositories exist (Phase 2). Empty: the
    // newest run the gateway lists.
    "DEMO_RUN": "",
    // Ask's classifier, as in packages/web: keywords unless an AI binding is added.
    "ASK_CLASSIFIER": "keywords",
    "ASK_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast",
    // Who orders what ask_repo returns, as in packages/web: "jev" (Jev on Workers AI through
    // the AI Gateway in JEV_GATEWAY) or "rules". Answers carry the receipts either way.
    "PICKER": "jev",
    "JEV_GATEWAY": "default",
  },
  // Workers AI, for Jev; billed to the account, no API key involved.
  "ai": { "binding": "AI", "remote": true },
  // Every read goes through the gateway over RPC; the run-token check too (`verifyMcpToken`).
  "services": [{ "binding": "GATEWAY", "service": "beanstalk-gateway" }],
  // OAuth clients, grants and tokens (@cloudflare/workers-oauth-provider stores only hashes),
  // plus pending consent requests. Provisioned on first deploy.
  "kv_namespaces": [{ "binding": "OAUTH_KV" }],
  // Accounts (docs/claude-opus/19-accounts-and-auth.md): grants are audited here and session
  // git tokens minted here. Schema: packages/shared-identity/migrations.
  "d1_databases": [
    {
      "binding": "IDENTITY_DB",
      "database_name": "beanstalk-identity",
      "migrations_dir": "../shared-identity/migrations",
    },
  ],
}
