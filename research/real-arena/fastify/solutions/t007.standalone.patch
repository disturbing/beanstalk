diff --git a/lib/error-status.js b/lib/error-status.js
new file mode 100644
index 00000000..e6baea2b
--- /dev/null
+++ b/lib/error-status.js
@@ -0,0 +1,14 @@
+'use strict'
+
+const {
+  kReplyHasStatusCode
+} = require('./symbols')
+
+function setErrorStatusCode (reply, err) {
+  if (!reply[kReplyHasStatusCode] || reply.statusCode === 200) {
+    const statusCode = err && (err.statusCode || err.status)
+    reply.code(statusCode >= 400 ? statusCode : 500)
+  }
+}
+
+module.exports = { setErrorStatusCode }
