+# ---- Mixed fleet -------------------------------------------------------------------------------------
+
+class MixedAdapter(Adapter):
+    """A mixed fleet: every agent slot is bound to one vendor for the whole race (``--agent mixed``).
+
+    Even slots (a0, a2, ...) run Claude Code, odd slots (a1, a3, ...) run Codex, so 12 agents are 6 and 6.
+    ``route`` picks the concrete adapter from ``spec.agent_id``; an invocation without an agent slot
+    (classifier) goes to Claude. A session can only be resumed by the vendor that started it, so the harness
+    asks ``resumable_by`` (Claude sessions resume on Claude slots; Codex reworks start fresh sessions).
+    """
+    name = "mixed"
+
+    def __init__(self, claude: ClaudeAdapter, codex: CodexAdapter):
+        self.claude, self.codex = claude, codex
+        self.model = f"{claude.model}+{codex.model or 'codex-default'}"
+        self.slot_vendor: dict[str, str] = {}
+
+    def assign(self, slot_ids: list[str]) -> dict[str, str]:
+        self.slot_vendor = {sid: ("claude" if i % 2 == 0 else "codex") for i, sid in enumerate(slot_ids)}
+        return dict(self.slot_vendor)
+
+    def vendor_of(self, agent_id: str | None) -> str:
+        return self.slot_vendor.get(agent_id or "", "claude")
+
+    def route(self, spec: InvocationSpec) -> Adapter:
+        return self.codex if self.vendor_of(spec.agent_id) == "codex" else self.claude
+
+    def resumable_by(self, session_id: str | None, agent_id: str | None) -> bool:
+        return self.vendor_of(agent_id) == "claude" and self.claude.resumable(session_id)
+
+    async def run(self, spec: InvocationSpec, progress: Callable[[float], None] | None = None) -> InvocationResult:
+        return await self.route(spec).run(spec, progress)
+
+
