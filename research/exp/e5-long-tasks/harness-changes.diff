+    # ---- E5: emulated drift and machine load -------------------------------------------------------------------
+
+    def drift_delay(self, spec: InvocationSpec, res: InvocationResult) -> float:
+        """Extra seconds an agent invocation is held before its result is used (``--drift-factor``, ``--drift-seconds``).
+        Only real agent work is stretched (initial, rework, fixer), never classifiers; an invocation that never ran
+        (infra error) is not stretched."""
+        cfg = self.cfg
+        if spec.kind not in ("initial", "rework", "fixer") or res.infra_error or cfg.agent == "none":
+            return 0.0
+        return max(0.0, (cfg.drift_factor - 1.0) * res.wall_ms / 1000.0) + max(0.0, cfg.drift_seconds)
 
+    @staticmethod
+    def machine_load() -> dict:
+        """``uptime`` and the load averages (the machine is shared; races are timed under whatever load it has)."""
+        import subprocess
+        try:
+            up = subprocess.run(["uptime"], capture_output=True, text=True, timeout=10).stdout.strip()
+        except Exception:  # noqa: BLE001
+            up = ""
+        try:
+            la = [round(x, 2) for x in os.getloadavg()]
+        except OSError:
+            la = []
+        return {"uptime": up, "loadavg": la}
+
+    async def load_sampler(self, every: float = 30.0) -> None:
+        while True:
+            await asyncio.sleep(every)
+            self.log("load.sample", **self.machine_load())
+
