+
+/** Sales tax by country, then by region (province or state), split into federal and regional parts. */
+const RATES: Record<string, Record<string, TaxComponents>> = {
   CA: {
-    AB: 0.05,
-    BC: 0.12,
-    MB: 0.12,
-    NB: 0.15,
-    NL: 0.15,
