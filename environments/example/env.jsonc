// One Gitstalk environment. Copy this directory to environments/<name>/ (staging, production,
// or your own), fill in the account and subdomain, then:
//
//   pnpm env:provision <name>   create the D1, KV, R2 and queues it needs, record their ids in
//                               resources.json, generate missing secrets, apply D1 migrations
//   pnpm env:deploy <name>      check the secrets, then deploy every package below in order
//
// The public repo ignores environments/* except this example. In a (private) fork, commit
// env.jsonc and resources.json with `git add -f environments/<name>/env.jsonc ...`; never
// commit environments/<name>/secrets/. See docs/claude-opus/30-environments.md.
{
  // The Cloudflare account every Wrangler command for this environment targets (wrangler whoami).
  "account_id": "00000000000000000000000000000000",
  // Appended to every Worker and resource name: "-staging" gives beanstalk-gateway-staging,
  // beanstalk-forge-staging, beanstalk-repos-staging... "" keeps the base names.
  "suffix": "-staging",
  // Workers are reached at https://<worker>.<subdomain>.workers.dev unless `urls` names one.
  "workers_dev_subdomain": "your-subdomain",
  // Optional custom origins (routes or custom domains go in `overrides.<package>.routes`).
  // "urls": { "web": "https://git.example.com", "mcp": "https://mcp.example.com" },
  // Deployed in this order whatever the order here: actions-executor, gateway, mcp, web, ssh,
  // oidc, swarm, site.
  "packages": ["actions-executor", "gateway", "web", "mcp", "ssh", "site"],
  // Merged into each package's generated config: objects key by key, arrays of bindings or
  // containers by their binding / class_name, anything else replaced.
  "overrides": {
    "gateway": {
      "vars": { "RUNNER_MAX_INSTANCES": "4", "ACTIONS_MAX_INSTANCES": "2" },
      "containers": [{ "class_name": "Runner", "max_instances": 4 }],
    },
    "actions-executor": {
      "vars": { "ACTIONS_MAX_INSTANCES": "2" },
      "containers": [{ "class_name": "ActionsJobContainer", "max_instances": 2 }],
    },
    // Rate-limit namespaces are per account: give each environment its own.
    "web": { "ratelimits": [{ "name": "SIGNIN_RATE_LIMIT", "namespace_id": "4102" }] },
    // No Spectrum app in front of a test stack: reach the SSH server over GET /tunnel.
    "ssh": { "vars": { "SSH_TUNNEL": "on" } },
  },
}
